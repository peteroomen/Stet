{
  "name": "stet",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "STET \u2014 a 5x5 swipe-crawl. Every stroke stands.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "model": "vite-node scripts/model.ts",
    "check:swipe": "vite build && node scripts/swipe-check.mjs",
    "shots:brush": "node scripts/brush-shots.mjs",
    "shots:strike": "vite build && node scripts/strike-frames.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright-core": "^1.62.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
